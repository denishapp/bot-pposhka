# Скопіюйте цей файл у .env для локального запуску (не комітьте .env у git!)
# На Railway/Render ці ж змінні додаються через панель налаштувань проєкту.

# Токен бота від @BotFather (Telegram → /mybots → ваш бот → API Token)
BOT_TOKEN=

# Публічний URL вашої гри (GitHub Pages), яку відкриває кнопка "Грати"
GAME_URL=https://ваш-username.github.io/ваш-репозиторій/

# Порт, на якому слухає сервер (хостинг зазвичай підставляє свій автоматично)
PORT=3000
